# tizimchi.com — sayt (dist/) o'z serveringizda (VPS). Caddy HTTPS sertifikatini o'zi oladi va yangilaydi.
# Bu SHABLON: deploy/deploy-vps.sh uni to'ldirib serverga /etc/caddy/sites/tizimchi.com.caddy qilib yozadi
# (serverdagi Caddy /etc/caddy/sites/*.caddy ni import qiladi). To'ldiriladigan joylar:
#   __CSP__         — dist/.csp (build yaratadi; backend ulangach Supabase manzili ham o'sha yerda bo'ladi)
#   __APP_TARGET__  — ilovaning amaldagi manzili (app.tizimchi.com; u ulanguncha — avvalgi manzil)
#   YUKLAB_REDIRS (o'z qatorida, ikki pastki chiziq bilan) — /yuklab/windows va /yuklab/android → eng yangi fayl (dist/.yuklab dan)
# Sarlavhalar dist/_headers (Netlify/Cloudflare) bilan bir xil.

tizimchi.com {
	root * /var/www/tizimchi-sayt
	encode zstd gzip

	header {
		Content-Security-Policy "__CSP__"
		X-Content-Type-Options nosniff
		X-Frame-Options DENY
		Referrer-Policy strict-origin-when-cross-origin
		Permissions-Policy "camera=(), microphone=(), geolocation=(), interest-cohort=()"
		Strict-Transport-Security "max-age=31536000"
		-Server
	}

	# Xeshli fayllar (nom o'zgaradi) — 1 yil kesh; sahifalar — har safar tekshiriladi
	@assets path /assets/*
	header @assets Cache-Control "public, max-age=31536000, immutable"
	@pages path *.html / */
	header @pages Cache-Control no-cache

	@korish path /video-qollanmalar/korish/*
	header @korish X-Robots-Tag noindex
	@admin path /admin/*
	header @admin X-Robots-Tag "noindex, nofollow"

	redir /biznes-turlari/ombor-ulgurji/* /biznes-turlari/ombor/ permanent

	# Ilova: barqaror manzil tizimchi.com/ilova/… → ilovaning amaldagi joyi (yo'l va so'rov saqlanadi).
	# Ilova ko'chsa — faqat shu qator o'zgaradi, sayt qayta build qilinmaydi.
	# handle_path prefiksni redir dan OLDIN olib tashlaydi (oddiy «uri strip_prefix» redir dan keyin bajarilardi)
	handle_path /ilova* {
		redir __APP_TARGET__{uri} 302
	}

	# Video qo'llanmalar (npm run video -- add … → media/; deploy-vps.sh yuklaydi). Saytdagi havolalarda ?v=<xesh> bor — video
	# yangilansa manzil o'zgaradi, shuning uchun 7 kunlik kesh xavfsiz. Range so'rovlari (videoni o'rtasidan ko'rish) ishlaydi.
	handle_path /media/* {
		root * /var/www/tizimchi-media
		header Cache-Control "public, max-age=604800"
		file_server
	}

	# Ilovani yuklab olish (npm run yuklab → yuklab/; deploy-vps.sh yuklaydi va SHA-256 ni serverda tekshiradi).
	# Fayl nomida versiya bor — mazmuni o'zgarmaydi, uzoq kesh. Range ishlaydi: uzilgan yuklash davom ettiriladi.
	# Qisqa havolalar (Telegram'da ulashish uchun) — doim eng yangi faylga:
__YUKLAB_REDIRS__
	handle_path /yuklab/* {
		root * /var/www/tizimchi-yuklab
		@apk path *.apk
		header @apk Content-Type application/vnd.android.package-archive
		@exe path *.exe
		header @exe Content-Type application/vnd.microsoft.portable-executable
		header Content-Disposition attachment
		header Cache-Control "public, max-age=31536000, immutable"
		file_server
	}

	# Papka manzillari (/aloqa/) → index.html; topilmasa — 404 sahifasi (/media/ va /yuklab/ ichida ham saytniki)
	handle {
		try_files {path} {path}/index.html
		file_server
	}
	handle_errors {
		root * /var/www/tizimchi-sayt
		# Xato javobiga avvalgi yo'lning sarlavhalari o'tmasin (/yuklab/ dagi exe turi, «attachment» va 1 yillik kesh —
		# aks holda yo'q fayl uchun 404 yuklab olinadigan fayl bo'lib, bir yilga keshlanib qolardi)
		header -Content-Type
		header -Content-Disposition
		header Cache-Control no-cache
		@404 expression {err.status_code} == 404
		rewrite @404 /404.html
		file_server
	}
}

www.tizimchi.com {
	redir https://tizimchi.com{uri} permanent
}
